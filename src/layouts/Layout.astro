---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  demo?: boolean;
}

const { title, description, demo = false } = Astro.props;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Domine:wght@500;600;700&family=Work+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
    {demo && (
      <>
        <div class="watermark" aria-hidden="true"></div>
        <div class="watermark-badge">MID · wersja demo</div>
      </>
    )}
  </body>
</html>
