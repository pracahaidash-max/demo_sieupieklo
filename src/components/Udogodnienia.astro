---
interface Props {
  pozycje: string[];
}
const { pozycje } = Astro.props;
---

<section class="udog">
  <div class="wrap">
    <span class="eyebrow">Warto wiedzieć</span>
    <ul class="badges">
      {pozycje.map((p) => (
        <li>
          <span class="check">✓</span>
          {p}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .udog {
    padding: 2.75rem 0;
    background: var(--cream);
  }
  .badges {
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .badges li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.5rem 1rem;
    font-size: 0.86rem;
    color: var(--ink-soft);
  }
  .check {
    color: var(--petrol);
    font-weight: 700;
  }
</style>
