---
interface Props {
  color: string;
  background: string;
  flip?: boolean;
}
const { color, background, flip = false } = Astro.props;
---

<svg
  class="scallop"
  viewBox="0 0 120 12"
  preserveAspectRatio="none"
  style={`background:${background}; ${flip ? "transform: rotate(180deg);" : ""}`}
  aria-hidden="true"
>
  <path
    d="M0,0 C5,12 15,12 20,0 C25,12 35,12 40,0 C45,12 55,12 60,0 C65,12 75,12 80,0 C85,12 95,12 100,0 C105,12 115,12 120,0 L120,12 L0,12 Z"
    fill={color}
  ></path>
</svg>
