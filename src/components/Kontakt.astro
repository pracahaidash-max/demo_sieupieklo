---
interface Firma {
  nazwa: string;
  adres_ulica: string;
  adres_miasto: string;
  telefon: string;
  email: string;
  instagram: string;
}
interface Props {
  naglowek: string;
  podtytul: string;
  firma: Firma;
}
const { naglowek, podtytul, firma } = Astro.props;
const maEmail = !firma.email.startsWith("TODO");
---

<section id="kontakt" class="kontakt">
  <div class="wrap grid">
    <div class="copy">
      <span class="eyebrow">Kontakt</span>
      <h2>{naglowek}</h2>
      <p>{podtytul}</p>

      <dl class="dane">
        <div>
          <dt>Adres</dt>
          <dd>{firma.adres_ulica}<br />{firma.adres_miasto}</dd>
        </div>
        <div>
          <dt>Telefon</dt>
          <dd>{firma.telefon}</dd>
        </div>
        {maEmail && (
          <div>
            <dt>E-mail</dt>
            <dd>{firma.email}</dd>
          </div>
        )}
        <div>
          <dt>Instagram</dt>
          <dd><a href={firma.instagram} target="_blank" rel="noopener">@cukiernia_ciasta_torty</a></dd>
        </div>
      </dl>
    </div>

    <form name="zamowienie" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="form">
      <input type="hidden" name="form-name" value="zamowienie" />
      <p class="honey"><label>Nie wypełniaj: <input name="bot-field" /></label></p>

      <label>
        Imię i nazwisko
        <input type="text" name="imie" required />
      </label>
      <label>
        Telefon
        <input type="tel" name="telefon" required />
      </label>
      <label>
        E-mail
        <input type="email" name="email" />
      </label>
      <label>
        Na kiedy i na ile osób?
        <input type="text" name="termin" placeholder="np. 20 sierpnia, 15 osób" />
      </label>
      <label>
        Opis zamówienia
        <textarea name="wiadomosc" rows="4" placeholder="Okazja, smak, motyw, budżet…"></textarea>
      </label>

      <button type="submit" class="btn btn-primary">Wyślij zapytanie</button>
    </form>
  </div>
</section>

<style>
  .kontakt {
    background: var(--surface);
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    align-items: start;
  }
  h2 {
    font-size: clamp(1.6rem, 2.8vw, 2.1rem);
    margin-top: 0.6rem;
    max-width: 20ch;
  }
  .copy p {
    margin-top: 0.9rem;
    color: var(--ink-soft);
  }
  .dane {
    margin: 2.25rem 0 0;
    display: grid;
    gap: 1.1rem;
  }
  .dane dt {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--petrol);
    font-weight: 600;
  }
  .dane dd {
    margin: 0.2rem 0 0;
    font-size: 1rem;
  }
  .dane a {
    color: var(--raspberry-deep);
    text-decoration: none;
    font-weight: 600;
  }
  .form {
    display: grid;
    gap: 1rem;
    background: var(--cream);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 1.75rem;
  }
  .honey {
    position: absolute;
    left: -9999px;
  }
  .form label {
    display: grid;
    gap: 0.4rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--ink-soft);
  }
  .form input,
  .form textarea {
    font: inherit;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
    color: var(--ink);
  }
  .form input:focus,
  .form textarea:focus {
    outline: 2px solid var(--raspberry);
    outline-offset: 1px;
  }
  .form button {
    margin-top: 0.4rem;
    justify-self: start;
  }
  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
