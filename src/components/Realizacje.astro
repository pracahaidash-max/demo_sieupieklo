---
interface Pozycja {
  zdjecie: string;
  nazwa: string;
  opis: string;
}
interface Props {
  realizacje: Pozycja[];
}
const { realizacje } = Astro.props;
const tilt = [-3, 2, -2, 3, -2.5, 2.5, -3, 2, -2, 3, -2.5];
---

<section id="realizacje" class="realizacje">
  <div class="wrap">
    <span class="eyebrow">Realizacje</span>
    <h2>Prosto z naszej lady</h2>
    <p class="intro">Kilka ostatnich tortów i wypieków — prawdziwe zdjęcia z naszej cukierni na Wawrzyszewskiej.</p>

    <div class="grid">
      {realizacje.map((r, i) => (
        <figure class="polaroid" style={`--tilt:${tilt[i % tilt.length]}deg`}>
          <img src={r.zdjecie} alt={r.nazwa} loading="lazy" width="400" height="400" />
          <figcaption>
            <strong>{r.nazwa}</strong>
            <span>{r.opis}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .realizacje {
    background: var(--surface);
  }
  h2 {
    font-size: clamp(1.7rem, 3vw, 2.3rem);
    margin-top: 0.6rem;
    max-width: 22ch;
  }
  .intro {
    margin-top: 0.9rem;
    color: var(--ink-soft);
  }
  .grid {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2.25rem 1.75rem;
  }
  .polaroid {
    margin: 0;
    background: #fff;
    padding: 0.6rem 0.6rem 0.9rem;
    border-radius: 4px;
    box-shadow: 0 10px 24px -14px rgba(44, 30, 24, 0.35);
    transform: rotate(var(--tilt));
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .polaroid:hover {
    transform: rotate(0deg) translateY(-4px);
    box-shadow: 0 16px 32px -14px rgba(44, 30, 24, 0.4);
  }
  .polaroid img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 2px;
  }
  .polaroid figcaption {
    margin-top: 0.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .polaroid strong {
    font-family: var(--font-display);
    font-size: 0.92rem;
    color: var(--raspberry-deep);
  }
  .polaroid span {
    font-size: 0.78rem;
    color: var(--ink-soft);
    line-height: 1.4;
  }
  @media (max-width: 980px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 700px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.75rem 1.25rem;
    }
    .polaroid {
      transform: none;
    }
  }
</style>
