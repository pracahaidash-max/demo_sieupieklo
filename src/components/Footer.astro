---
interface Firma {
  nazwa: string;
  adres_ulica: string;
  adres_miasto: string;
  instagram: string;
}
interface Props {
  firma: Firma;
}
const { firma } = Astro.props;
const rok = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap grid">
    <div>
      <span class="brand-name">{firma.nazwa}</span>
      <p>{firma.adres_ulica}, {firma.adres_miasto}</p>
      <p><a href={firma.instagram} target="_blank" rel="noopener">@cukiernia_ciasta_torty</a></p>
    </div>
    <nav aria-label="Nawigacja w stopce">
      <a href="#oferta">Oferta</a>
      <a href="#realizacje">Realizacje</a>
      <a href="#opinie">Opinie</a>
      <a href="#kontakt">Kontakt</a>
    </nav>
  </div>
  <div class="wrap bottom">
    <p>&copy; {rok} {firma.nazwa}. Wszelkie prawa zastrzeżone.</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--petrol-deep);
    color: rgba(253, 244, 232, 0.8);
    padding-top: 3.5rem;
  }
  .grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: 2.5rem;
  }
  .brand-name {
    font-family: var(--font-display);
    font-weight: 700;
    color: #fff;
    font-size: 1.05rem;
  }
  .grid p {
    margin-top: 0.5rem;
    font-size: 0.9rem;
  }
  .grid a {
    text-decoration: none;
    color: inherit;
  }
  .grid a:hover {
    color: #fff;
  }
  nav {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: 0.92rem;
  }
  nav a {
    text-decoration: none;
    color: rgba(253, 244, 232, 0.8);
  }
  nav a:hover {
    color: #fff;
  }
  .bottom {
    border-top: 1px solid rgba(253, 244, 232, 0.14);
    padding: 1.25rem 1.5rem;
    font-size: 0.8rem;
  }
</style>
